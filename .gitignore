# Secrets. Never commit.
.env

# Python
__pycache__/
*.pyc
venv/
.venv/

# Model weights. Multi-MB binaries that pip/ultralytics re-downloads on
# demand -- keeping them out of git history keeps the clone fast.
*.pt

# Generated incident reports. The directory is tracked (.gitkeep), the
# PDFs in it are not: they are demo output, regenerated on every run.
outputs/*.pdf
outputs/*.json

# Synthesized speech, keyed by (text, language). Regenerated on demand
# and deliberately warm before a demo -- see tts_alert.py --prefetch.
outputs/tts_cache/

# Downloaded eval datasets. ~180MB of images, fetched on demand by
# eval_accuracy.py --fetch. Never in git.
datasets/

# Evidence frames from live triggers. Regenerated every run.
outputs/evidence/
