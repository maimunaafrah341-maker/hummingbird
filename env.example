# Copy to .env and fill in. .env must never be committed.
#
# Only translation.py needs a key. language.py needs none at all --
# detection runs entirely locally.

# At least ONE of the three below. llm.py tries them in this order and
# skips any that is unset, so one key is enough to run.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional. Unset means the API is open, which is right for a public
# demo. Set it and every endpoint except /health requires a matching
# X-API-Key header.
API_KEY=

# Optional. Set to 1 to load the embedding model at startup instead of
# on the first romanized request. Costs ~22s and ~800MB before the port
# opens -- leave it unset on a small host, where that is exactly what
# gets a container killed during boot. See EVAL.md.
WARM_UP=
