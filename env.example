# Copy to .env and fill in. .env must never be committed.
#
# Only translation.py needs a key. language.py needs none at all --
# detection runs entirely locally.

# At least ONE of the three below. llm.py tries them in this order and
# skips any that is unset, so one key is enough to run.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional. Unset means the API is open, which is right for a public
# demo. Set it and every endpoint except /health requires a matching
# X-API-Key header.
API_KEY=

# Optional. Set to 1 to load the embedding model at startup instead of
# on the first romanized request. Costs ~22s and ~800MB before the port
# opens -- leave it unset on a small host, where that is exactly what
# gets a container killed during boot. See EVAL.md.
WARM_UP=

# Featherless. Tried FIRST when set -- it is the provider this project
# is required to use; the others remain as failover.
#
# IMPORTANT, and it is a licensing point rather than a performance one:
# Featherless Chat/Premium plans are sold for human-driven interactive
# use and EXCLUDE automation. Developer plans are the API-driven ones.
# So the only model call in this project is operator-initiated
# (POST /incident/brief) and the autonomous safety path never touches a
# model. A 429 from a Chat-tier key is the plan refusing automated
# traffic -- a bigger Chat tier does not fix that.
#
# A new account gets 100,000 trial tokens, no card. At ~600 tokens per
# brief that is 150+ presses, which is more than a demo needs.
FEATHERLESS_API_KEY=

# Optional. Which models the key can reach depends on the plan tier, so
# this is a comma-separated list tried in order.
FEATHERLESS_MODELS=
