# Where the incident backend lives.
#
# Unset (the default) means same-origin relative paths, which is what
# local development wants: `pnpm dev` serves the client and the Express
# server in server/index.ts answers on the same host.
#
# Set it to the teammate's deployed backend to point this console at the
# real service. No trailing slash needed -- it is stripped either way.
#
#   VITE_API_BASE_URL=https://hazardwatch-api.onrender.com
#
# READ THIS BEFORE DEPLOYING: Vite inlines import.meta.env at BUILD
# time. Setting this variable on the server after the bundle is built
# changes nothing -- it has to be set before `pnpm build`, and changing
# it means rebuilding. This is the single most common way an hour gets
# lost on deployment day.
#
# Copy to .env.local (gitignored) and fill in.
VITE_API_BASE_URL=
